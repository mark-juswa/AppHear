    {"kind":"NAME","pattern":"(?:and )?your (?:first |last |full )?name"},
    {"kind":"NAME","pattern":"who are you|what (?:should|do|can) (?:i|we|people) call you|what do you go by"},
    {"kind":"PLACE","pattern":"where (?:are|were) you(?: at)?"},
    {"kind":"PLACE","pattern":"where (?:are|were) you (?:from|born|raised|living|staying)"},
    {"kind":"PLACE","pattern":"where (?:do|did) you (?:live|stay|come from|grow up)"},
    {"kind":"PLACE","pattern":"where (?:are|were) you (?:going|headed|heading)(?: to)?"},
    {"kind":"PLACE","pattern":"where (?:did|do|will|would) you (?:go|travel|work|study|go to school)"},
