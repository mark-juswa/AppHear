    {"kind":"PLACE","pattern":"where (?:is|was) your (?:house|home|school|office|work|workplace|hometown|home town)"},
    {"kind":"PLACE","pattern":"what (?:city|town|country|province|state|street|school|place) (?:are you from|do you live in|did you live in|were you born in|do you go to|do you study at|do you work at|are you going to)"},
    {"kind":"PLACE","pattern":"what is the name of (?:your city|your town|your school|your street|your company|that place|the place)"},
