    {"kind":"SPELL","pattern":"(?:please )?spell(?: it| that| (?:your |the |his |her )?(?:name|first name|last name|full name|city|town|place|word|address))?"},
    {"kind":"SPELL","pattern":"(?:can|could|would) you (?:please )?spell(?: it| that| (?:your |the |his |her )?(?:name|first name|last name|full name|city|town|place|word|address))?"},
    {"kind":"SPELL","pattern":"how do you spell (?:your |the |his |her )?(?:name|first name|last name|full name|city|town|place|word|address|it|that)"}
