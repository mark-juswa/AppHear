<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/error_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/component_error_state_title"
        android:textAppearance="@style/TextAppearance.AppHear.Headline" />

    <TextView
        android:id="@+id/error_state_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="@string/component_error_state_body"
        android:textAppearance="@style/TextAppearance.AppHear.Body.Secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/error_state_action"
        style="@style/Widget.AppHear.Button.Dark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/component_error_state_action" />
</LinearLayout>