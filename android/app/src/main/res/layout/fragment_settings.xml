<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F5EC">

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingTop="50dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_black"
                android:includeFontPadding="false"
                android:text="@string/profile_preferences_line_1"
                android:textColor="#111111"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="@font/inter_black"
                android:includeFontPadding="false"
                android:text="@string/profile_preferences_line_2"
                android:textColor="#111111"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/settings_intro"
                android:textColor="#9A9286"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/settings_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_settings_panel_coffee"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="14dp">

                <include layout="@layout/row_setting_account_type" />
                <include layout="@layout/row_setting_recognition_mode" />
                <include layout="@layout/row_setting_recognition_engine" />
            <include layout="@layout/row_setting_asl_character" />
                <include layout="@layout/row_setting_voice" />
                <include layout="@layout/row_setting_accessibility" />
                <include layout="@layout/row_setting_privacy" />
                <include layout="@layout/row_setting_about" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:text="@string/profile_version_note"
                android:textColor="#A49B8D"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

