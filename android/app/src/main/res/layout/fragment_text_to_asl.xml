<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810">

    <FrameLayout
        android:id="@+id/avatarStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#11151D"
        app:layout_constraintBottom_toTopOf="@id/text_to_asl_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <WebView
            android:id="@+id/avatarWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/avatarPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.55"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Avatar viewer loading"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

    <View
        android:id="@+id/topGradient"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/circle_btn_white"
        android:contentDescription="Back"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#0D1B1E" />

    <TextView
        android:id="@+id/text_to_asl_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.05"
        android:text="ASL PHRASE PREVIEW"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnSpeak"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/circle_btn_white"
        android:contentDescription="Speak aloud"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#0D1B1E" />

    <FrameLayout
        android:id="@+id/reply_button"
        android:layout_width="72dp"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_white_pill"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="@id/btnSpeak"
        app:layout_constraintTop_toBottomOf="@id/btnSpeak">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/text_to_asl_reply"
            android:textColor="#0D1B1E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/signOverlay"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        app:layout_constraintBottom_toTopOf="@id/text_to_asl_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/current_sign_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_black"
            android:text="@string/text_to_asl_current_sign_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/current_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter_regular"
            android:text="@string/text_to_asl_no_animation"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/text_to_asl_bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:id="@+id/dragHandleWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="#DDDDDD" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.25"
                        android:text="SIGNING"
                        android:textColor="#8C775B"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/signed_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_black"
                        android:letterSpacing="-0.02"
                        android:text="@string/text_to_asl_idle_text"
                        android:textColor="#2AA897"
                        android:textSize="36sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/replay_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_tan"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Replay"
                        android:src="@drawable/ic_replay"
                        app:tint="#2AA897" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/preview_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/asl_preview_notice"
                android:textColor="#685239" android:textSize="13sp" />
            <LinearLayout android:id="@+id/playback_controls"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/pause_button"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:enabled="false" android:text="@string/asl_pause" />
                <Button android:id="@+id/speed_button"
                    android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:text="@string/asl_speed_normal" />
            </LinearLayout>
            <ScrollView
                android:id="@+id/expandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="20dp"
                        android:background="#EEEEEE" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_toggle_container">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <FrameLayout
                                android:id="@+id/mode_text_button"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_toggle_active"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:id="@+id/mode_text_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/inter_semibold"
                                    android:text="Text"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/mode_speech_button"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_toggle_inactive"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:id="@+id/mode_speech_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/inter_semibold"
                                    android:text="Speech"
                                    android:textColor="#8C775B"
                                    android:textSize="14sp" />
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/text_input_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <EditText
                            android:id="@+id/input_text"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_white_pill"
                            android:fontFamily="@font/inter_regular"
                            android:hint="@string/text_to_asl_input_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textCapSentences"
                            android:paddingHorizontal="20dp"
                            android:singleLine="true"
                            android:textColor="#1A2030"
                            android:textColorHint="#A0A090"
                            android:textSize="16sp" />

                        <FrameLayout
                            android:id="@+id/sign_it_button"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/btn_start_bg"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/inter_black"
                                android:letterSpacing="0.12"
                                android:text="@string/text_to_asl_sign_it"
                                android:textColor="#FAEFD9"
                                android:textSize="15sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/speech_deferred_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:id="@+id/btnMic"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_circle_tan">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:contentDescription="Microphone"
                                android:src="@drawable/ic_mic"
                                app:tint="#2AA897" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvSpeechStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="@string/text_to_asl_speech_deferred_title"
                            android:textColor="#8C775B"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>


            <FrameLayout
                android:id="@+id/clear_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="0.1"
                    android:text="@string/text_to_asl_clear"
                    android:textColor="#8C775B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>