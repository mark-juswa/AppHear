<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B201F">

    <FrameLayout
        android:id="@+id/avatarStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0B201F"
        app:layout_constraintBottom_toTopOf="@id/text_to_asl_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <WebView
            android:id="@+id/avatarWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/avatarPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.65"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Avatar viewer loading"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

    <View
        android:id="@+id/topGradient"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/circle_btn_white"
        android:contentDescription="Back"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#0D1B1E" />

    <TextView
        android:id="@+id/text_to_asl_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.05"
        android:text="ASL TRANSLATOR"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnSpeak"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/circle_btn_white"
        android:contentDescription="Speak aloud"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#0D1B1E" />

    <FrameLayout
        android:id="@+id/reply_button"
        android:layout_width="80dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_white_pill"
        android:clickable="true"
        android:contentDescription="@string/text_to_asl_reply"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/text_to_asl_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/text_to_asl_reply"
            android:textColor="#0D1B1E"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/signOverlay"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/text_to_asl_bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/current_sign_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/text_to_asl_current_sign_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/current_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:fontFamily="@font/inter_regular"
            android:text="@string/text_to_asl_no_animation"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/text_to_asl_bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingBottom="26dp">

            <FrameLayout
                android:id="@+id/dragHandleWrapper"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:clickable="true"
                android:contentDescription="Expand or collapse translator controls"
                android:focusable="true">

                <View
                    android:layout_width="38dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/apphear_translator_handle_bg" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/translator_mode_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.22"
                        android:text="@string/text_to_asl_sign_label"
                        android:textColor="#8C775B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/signed_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:clickable="true"
                        android:contentDescription="@string/text_to_asl_open_text_input"
                        android:focusable="true"
                        android:fontFamily="@font/inter_black"
                        android:text="@string/text_to_asl_idle_text"
                        android:textColor="#29AC9B"
                        android:textSize="23sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/replay_button"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_circle_tan"
                    android:clickable="true"
                    android:contentDescription="Replay signing"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:contentDescription="Replay"
                        android:src="@drawable/ic_replay"
                        app:tint="#29AC9B" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/mode_selector"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/apphear_translator_segment_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <FrameLayout
                        android:id="@+id/mode_text_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_toggle_active"
                        android:clickable="true"
                        android:contentDescription="Text mode"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/mode_text_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Text"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/mode_speech_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_toggle_inactive"
                        android:clickable="true"
                        android:contentDescription="Talk mode"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/mode_speech_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/text_to_asl_mode_talk"
                            android:textColor="#8C775B"
                            android:textSize="15sp" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/expandableContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/text_input_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/mode_talk_shortcut"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:contentDescription="Switch to Talk"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/translator_voice_search" />

                    <EditText
                        android:id="@+id/input_text"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/apphear_translator_input_line_bg"
                        android:fontFamily="@font/inter_semibold"
                        android:hint="@string/text_to_asl_input_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="2dp"
                        android:singleLine="true"
                        android:textColor="#29AC9B"
                        android:textColorHint="#29AC9B"
                        android:textSize="18sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/speech_deferred_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/mode_text_shortcut"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:contentDescription="Switch to Text"
                        android:focusable="true"
                        android:layout_gravity="top|start"
                        android:padding="9dp"
                        android:src="@drawable/translator_chatting" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/btnMic"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:clickable="true"
                            android:contentDescription="Tap microphone to speak"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="62dp"
                                android:layout_height="62dp"
                                android:layout_gravity="center"
                                android:contentDescription="Microphone"
                                android:src="@drawable/translator_voice_search" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvSpeechStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/speech_tap_mic"
                            android:textColor="#29AC9B"
                            android:textSize="17sp" />
                    </LinearLayout>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#EAEAE7" />

                <LinearLayout
                    android:id="@+id/action_row"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/apphear_translator_segment_bg"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <FrameLayout
                        android:id="@+id/sign_it_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:background="@drawable/btn_start_bg"
                        android:clickable="true"
                        android:contentDescription="@string/text_to_asl_sign_it"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/text_to_asl_sign_it"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/clear_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:contentDescription="@string/text_to_asl_clear"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/inter_semibold"
                            android:text="@string/text_to_asl_clear"
                            android:textColor="#8C775B"
                            android:textSize="15sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
