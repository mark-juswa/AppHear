<?xml version="1.0" encoding="utf-8"?>
<!-- Guided conversation demo (guidedDemo flag): scenario picker and controls on the Recognition
     screen. Same white card, tan overline and tan-outlined pills as the rest of the app. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="18dp"
    app:strokeWidth="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/demoOverline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.22"
                android:textColor="#8C775B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/demoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityHeading="true"
                android:fontFamily="@font/inter_black"
                android:textColor="#0D1B1E"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/demoBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingExtra="2dp"
                android:textColor="#5A5A55"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/demoScenarioList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
