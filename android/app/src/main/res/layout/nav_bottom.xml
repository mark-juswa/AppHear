<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/navHomeContainer"
        android:layout_width="73dp"
        android:layout_height="73dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_nav_active_circle"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/navIconHome"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="Home"
            android:src="@drawable/homes"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inactiveItemsContainer"
        android:layout_width="wrap_content"
        android:layout_height="63dp"
        android:background="@drawable/bg_nav_inactive_pill"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/navDetect"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconDetect"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Sign Detection"
                android:src="@drawable/user_images"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navAsl"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconAsl"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="ASL"
                android:src="@drawable/wave_hand"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconProfile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Profile"
                android:src="@drawable/users"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>