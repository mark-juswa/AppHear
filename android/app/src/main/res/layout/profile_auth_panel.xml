<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/profile_auth_header_dark" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:id="@+id/authHeader" android:layout_width="match_parent" android:layout_height="240dp" android:background="@drawable/profile_auth_header_dark" android:visibility="visible">
            <ImageView android:id="@+id/authMascot" android:layout_width="116dp" android:layout_height="130dp" android:layout_gravity="top|end" android:layout_marginTop="70dp" android:layout_marginEnd="18dp" android:contentDescription="@string/profile_auth_mascot" android:scaleType="fitCenter" android:src="@drawable/profile_auth_mascot" />
            <LinearLayout android:id="@+id/authHeroText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="120dp" android:paddingBottom="28dp">
                <TextView android:id="@+id/tvAuthTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/inter_black" android:text="@string/profile_auth_login_heading" android:textColor="#FFFFFF" android:textSize="26sp" />
                <TextView android:id="@+id/tvAuthSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="@font/inter_regular" android:text="@string/profile_auth_login_body" android:textColor="#BBD4CF" android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/authPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/profile_auth_panel_large" android:elevation="12dp" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="20dp" android:paddingBottom="28dp" android:visibility="visible" android:layout_marginTop="-24dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/profile_auth_segment" android:padding="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
                    <FrameLayout android:id="@+id/tabLogin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/profile_auth_segment_active" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/tvTabLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/inter_semibold" android:text="@string/profile_auth_login_tab" android:textColor="#0D2020" android:textSize="14sp" />
                    </FrameLayout>
                    <FrameLayout android:id="@+id/tabRegister" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true">
                        <TextView android:id="@+id/tvTabRegister" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/inter_semibold" android:text="@string/profile_auth_register_tab" android:textColor="#8A928E" android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:id="@+id/authContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <EditText android:id="@+id/inputUsername" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_auth_input_large" android:fontFamily="@font/inter_semibold" android:hint="@string/profile_input_username" android:inputType="text" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#1A1A1A" android:textColorHint="#9A9F9C" android:textCursorDrawable="@null" android:textSize="14sp" android:visibility="gone" android:saveEnabled="false" />
                <EditText android:id="@+id/inputEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_auth_input_large" android:fontFamily="@font/inter_semibold" android:hint="@string/profile_auth_email" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#1A1A1A" android:textColorHint="#9A9F9C" android:textCursorDrawable="@null" android:textSize="14sp" android:saveEnabled="false" />
                <EditText android:id="@+id/inputPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_auth_input_large" android:fontFamily="@font/inter_semibold" android:hint="@string/profile_auth_password" android:inputType="textPassword" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#1A1A1A" android:textColorHint="#9A9F9C" android:textCursorDrawable="@null" android:textSize="14sp" android:saveEnabled="false" />
                <EditText android:id="@+id/inputConfirmPassword" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_auth_input_large" android:fontFamily="@font/inter_semibold" android:hint="@string/profile_auth_confirm" android:inputType="textPassword" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#1A1A1A" android:textColorHint="#9A9F9C" android:textCursorDrawable="@null" android:textSize="14sp" android:visibility="gone" android:saveEnabled="false" />
                <CheckBox android:id="@+id/cbRemember" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:buttonTint="@color/color_brand_primary" android:text="@string/profile_auth_remember" android:textColor="#403E3A" android:textSize="12sp" android:checked="true" android:minHeight="48dp" />
                <TextView android:id="@+id/tvAuthStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#B05A32" android:textSize="12sp" />
                <FrameLayout android:id="@+id/btnAuthPrimary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/btn_start_bg" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/tvAuthPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/inter_black" android:text="@string/profile_auth_login" android:textColor="#FFFFFF" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/tvToggleAuth" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="@string/profile_auth_create" android:textColor="@color/color_brand_primary" android:textSize="14sp" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <TextView android:id="@+id/profile_auth_guest" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:fontFamily="@font/inter_semibold" android:text="@string/profile_auth_guest" android:textColor="@color/color_text_secondary" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>