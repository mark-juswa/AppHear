<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_setting_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="Privacy and Camera"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPrivacyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_regular"
            android:text="Recognition remains on-device"
            android:textColor="#8C775B"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPrivacyValue"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_setting_value_pill"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:minWidth="82dp"
        android:paddingHorizontal="12dp"
        android:text="On-device"
        android:textColor="#403E3A"
        android:textSize="13sp" />
</LinearLayout>