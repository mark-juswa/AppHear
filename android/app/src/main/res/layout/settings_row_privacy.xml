<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/apphear_settings_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_privacy_title"
            android:textAppearance="@style/TextAppearance.AppHear.Label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/settings_privacy_body"
            android:textAppearance="@style/TextAppearance.AppHear.Body.Secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_12"
        android:background="@drawable/apphear_setting_pill_bg"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:text="@string/settings_privacy_value"
        android:textAppearance="@style/TextAppearance.AppHear.Diagnostics"
        android:textColor="@color/color_text_primary" />
</LinearLayout>