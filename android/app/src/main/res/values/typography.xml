<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Inter is not imported until asset licensing is verified; use system families for now. -->
    <style name="TextAppearance.AppHear.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.AppHear.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.AppHear.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.AppHear.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.AppHear.Body.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.AppHear.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.AppHear.Diagnostics" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/color_text_on_dark</item>
    </style>
</resources>
