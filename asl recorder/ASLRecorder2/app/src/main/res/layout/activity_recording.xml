<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- ── Top bar ─────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous" />

        <TextView
            android:id="@+id/tvTopSignLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="HELLO"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btnPauseRecording"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/btn_pause"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnStopSession"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_red"
            android:text="@string/btn_stop_session"
            android:textColor="@color/color_rejected"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── Camera container ────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintVertical_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.aslrecorder.ui.LandmarkOverlayView
            android:id="@+id/landmarkOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Flash overlay (green/red) -->
        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/color_accepted" />

        <!-- Tracking badges (top-left of camera) -->
        <LinearLayout
            android:id="@+id/trackingBadgesLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badgeHands"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_gray"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="HANDS"
                android:textColor="@color/color_badge_gray"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgePose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_gray"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="POSE"
                android:textColor="@color/color_badge_gray"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeFace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_gray"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="FACE"
                android:textColor="@color/color_badge_gray"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Guidance message (center-bottom of camera) -->
        <TextView
            android:id="@+id/tvGuidanceMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_badge_yellow"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textColor="@color/color_warning"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Result label (ACCEPTED / REJECTED) shown on camera -->
        <TextView
            android:id="@+id/tvResultOnCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:alpha="0" />

        <!-- "HOLD YOUR HANDS" warning — shown when hands drop out mid-recording -->
        <TextView
            android:id="@+id/tvHoldHandsWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_red"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/warning_hold_hands"
            android:textColor="@color/color_rejected"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ── Bottom panel ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Speed info -->
        <TextView
            android:id="@+id/tvSpeedInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed: Normal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- BIG countdown -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/countdown_normal"
            android:textSize="80sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="0.9" />

        <!-- Countdown subtext -->
        <TextView
            android:id="@+id/tvCountdownSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/countdown_get_ready"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Countdown instruction (shown during 3-2-1, hidden at GO) -->
        <TextView
            android:id="@+id/tvCountdownInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/countdown_hold_instruction"
            android:textColor="@color/color_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Real-time hand coverage (shown only while recording) -->
        <TextView
            android:id="@+id/tvHandCoverageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/hand_coverage_label_default"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressHandCoverage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:max="30"
            android:progress="0"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/color_rejected"
            android:visibility="gone" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressBarAccepted"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/progress_fill" />

        <!-- Accepted fraction -->
        <TextView
            android:id="@+id/tvAcceptedFraction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="0 / 60 accepted"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Rejected + remaining row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRejectedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rejected: 0"
                android:textColor="@color/color_rejected"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRemainingCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Remaining: 60"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Rejection reason (hidden by default) -->
        <TextView
            android:id="@+id/tvRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_red"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/color_rejected"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Post-recording quality gate readout (coverage + PASSED/FAILED) -->
        <TextView
            android:id="@+id/tvQualityGateResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_green"
            android:padding="10dp"
            android:text=""
            android:textColor="@color/color_accepted"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone" />

        <!-- START button -->
        <Button
            android:id="@+id/btnStartSession"
            style="@style/Widget.Recorder.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_start_session" />

        <!-- REDO button (hidden until a rejection occurs) -->
        <Button
            android:id="@+id/btnRedoRejected"
            style="@style/Widget.Recorder.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="@string/btn_redo_rejected"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
